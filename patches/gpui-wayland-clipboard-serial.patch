diff --git a/crates/gpui/src/platform/linux/wayland/serial.rs b/crates/gpui/src/platform/linux/wayland/serial.rs
index eadc7a9ca9..11d89d9309 100644
--- a/crates/gpui/src/platform/linux/wayland/serial.rs
+++ b/crates/gpui/src/platform/linux/wayland/serial.rs
@@ -46,4 +46,26 @@ impl SerialTracker {
             .map(|serial_data| serial_data.serial)
             .unwrap_or(0)
     }
+
+    /// Returns the best available serial for clipboard selection operations.
+    ///
+    /// Wayland requires a valid input-event serial for `set_selection`. On first
+    /// launch, `KeyPress` may still be 0 if no keyboard key has been pressed yet.
+    /// Fall back through `MousePress` → `MouseEnter` so that mouse-triggered
+    /// clipboard writes (e.g. copy-on-select) work before the first keypress.
+    pub fn best_serial(&self) -> u32 {
+        // Prefer KeyPress – keyboard shortcuts are the most common clipboard trigger.
+        if let Some(s) = self.serials.get(&SerialKind::KeyPress) {
+            return s.serial;
+        }
+        // Fall back for mouse-driven copies (select-to-copy, context menu).
+        if let Some(s) = self.serials.get(&SerialKind::MousePress) {
+            return s.serial;
+        }
+        // Last resort – pointer enter always fires before any interaction.
+        if let Some(s) = self.serials.get(&SerialKind::MouseEnter) {
+            return s.serial;
+        }
+        0
+    }
 }
